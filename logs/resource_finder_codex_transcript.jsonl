          return common.aggregate_results(results)\n# Maintainers: Any dependency bumps should\n# invoke uv with python 3.12 \n[build-system]\nrequires = [\"setuptools>=64\", \"setuptools_scm[toml]>=8\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools_scm]\n# This is necessary for dependabot to work successfully.\n# Dependabot tries to build in a directory that doesn't have a .git directory.\n# So setuptools_scm is unable to compute a version, thus we need a fallback.\nfallback_version = \"0.0.0+unknown\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n# `register_tooling` is a sibling package to `inspect_evals`, intentionally\n# kept outside the `inspect_evals` namespace. See `src/register_tooling/__init__.py`.\ninclude = [\"inspect_evals*\", \"register_tooling*\"]\n\n[tool.setuptools.package-data]\n\"inspect_evals\" = [\"*/eval.yaml\"]\n\n[tool.inspect-evals-lint]\n# Evaluation checks are documented in AUTOMATED_CHECKS.md; rule pages at\n# https://github.com/Generality-Labs/inspect-evals-lint/tree/main/docs/rules\npreset = \"monorepo\"\n# Code shipped into sandboxes, fixtures and vendored sources. The AST-based rules\n# never read these files; some are not even valid Python 3.\nexclude = [\n  \"src/inspect_evals/cybench/challenges/**\",\n  \"src/inspect_evals/cyberseceval_4/insecure_code_detector/rules/semgrep/python/**\",\n  \"src/inspect_evals/ds1000/_resources/**\",\n  \"src/inspect_evals/gdm_in_house_ctf/challenges/**\",\n  \"src/inspect_evals/gdm_self_reasoning/data/**\",\n  \"src/inspect_evals/ipi_coding_agent/tests/**\",\n  \"src/inspect_evals/kernelbench/sandbox/_resources/**\",\n  \"src/inspect_evals/mlrc_bench/orig_benchmark_corrections/**\",\n  \"src/inspect_evals/moru/scripts/**\",\n  \"src/inspect_evals/osworld/container/**\",\n  \"src/inspect_evals/swe_bench/baseline/**\",\n  # Container-only scripts — dependencies (e.g. redis) are installed in the\n  # Dockerfile, not on the host.\n  \"src/inspect_evals/theagentcompany/servers/rocketchat/npc-data-population/**\",\n  \"src/inspect_evals/theagentcompany/tasks/ml_generate_gradcam/**\",\n  \"src/inspect_evals/threecb/task_configs/**\",\n]\n\n# Findings suppressed for whole packages. Each entry is a known gap; remove the\n# entry when the gap is closed.\n[tool.inspect-evals-lint.per-file-ignores]\n\"src/inspect_evals/abstention_bench/**\" = [\"external_dependencies\"]\n\"src/inspect_evals/agentdojo/**\" = [\"custom_tool_tests\"]\n\"src/inspect_evals/agentharm/**\" = [\"custom_tool_tests\"]\n\"src/inspect_evals/cti_realm/**\" = [\"external_dependencies\", \"record_to_sample_test\", \"custom_solver_tests\", \"custom_scorer_tests\", \"custom_tool_tests\"]\n\"src/inspect_evals/cybench/**\" = [\"external_dependencies\"]\n\"src/inspect_evals/cybergym/**\" = [\"external_dependencies\"]\n\"src/inspect_evals/cyberseceval_2/**\" = [\"main_file\"]\n\"src/inspect_evals/cyberseceval_3/**\" = [\"main_file\"]\n\"src/inspect_evals/cyberseceval_4/**\" = [\"main_file\"]\n\"src/inspect_evals/gdm_self_proliferation/**\" = [\"private_api_imports\"]\n\"src/inspect_evals/healthbench/**\" = [\"sample_ids\"]\n\"src/inspect_evals/ifevalcode/**\" = [\"external_dependencies\"]\n\"src/inspect_evals/tau2/**\" = [\"custom_tool_tests\"]\n# Shared helpers wrap private inspect_ai APIs on purpose, so the compatibility\n# handling lives in one place instead of in every evaluation that needs it.\n\"src/inspect_evals/utils/**\" = [\"private_api_imports\"]\n\"src/inspect_evals/vimgolf_challenges/**\" = [\"sample_ids\"]\n\"tests/threecb/**\" = [\"e2e_test\"]\n\"tests/utils/**\" = [\"tests_init\"]\n# GPU evaluations without a maintenance sandbox check task yet (IEBP006). Remove\n# when each ships a <eval>_sandbox_check task; see kernelbench for the pattern.\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:2:license: mit\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:3:library_name: transformers\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:40:    <img alt=\"License\" src=\"https://img.shields.io/badge/License-MIT-f5de53?&color=f5de53\" style=\"display: inline-block; vertical-align: middle;\"/>\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:121: For all our models, the maximum generation length is set to 32,768 tokens. For benchmarks requiring sampling, we use a temperature of $0.6$, a top-p value of $0.95$, and generate 64 responses per query to estimate pass@1.\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:193:For instance, you can easily start a service using [vLLM](https://github.com/vllm-project/vllm):\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:196:vllm serve deepseek-ai/DeepSeek-R1-Distill-Qwen-32B --tensor-parallel-size 2 --max-model-len 32768 --enforce-eager\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:209:1. Set the temperature within the range of 0.5-0.7 (0.6 is recommended) to prevent endless repetitions or incoherent outputs.\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:210:2. **Avoid adding a system prompt; all instructions should be contained within the user prompt.**\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:214:Additionally, we have observed that the DeepSeek-R1 series models tend to bypass thinking pattern (i.e., outputting \"\\<think\\>\\n\\n\\</think\\>\") when responding to certain queries, which can adversely affect the model's performance.\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:215:**To ensure that the model engages in thorough reasoning, we recommend enforcing the model to initiate its response with \"\\<think\\>\\n\" at the beginning of every output.**\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:217:## 7. License\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:218:This code repository and the model weights are licensed under the [MIT License](https://github.com/deepseek-ai/DeepSeek-R1/blob/main/LICENSE).\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:220:- DeepSeek-R1-Distill-Qwen-1.5B, DeepSeek-R1-Distill-Qwen-7B, DeepSeek-R1-Distill-Qwen-14B and DeepSeek-R1-Distill-Qwen-32B are derived from [Qwen-2.5 series](https://github.com/QwenLM/Qwen2.5), which are originally licensed under [Apache 2.0 License](https://huggingface.co/Qwen/Qwen2.5-1.5B/blob/main/LICENSE), and now finetuned with 800k samples curated with DeepSeek-R1.\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:221:- DeepSeek-R1-Distill-Llama-8B is derived from Llama3.1-8B-Base and is originally licensed under [llama3.1 license](https://huggingface.co/meta-llama/Llama-3.1-8B/blob/main/LICENSE).\nartifacts/resource_finder/models/deepseek-r1-distill-llama-8b/README.md:222:- DeepSeek-R1-Distill-Llama-70B is derived from Llama3.3-70B-Instruct and is originally licensed under [llama3.3 license](https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct/blob/main/LICENSE).\nartifacts/resource_finder/models/moonlight-16b-a3b-instruct/README.md:2:license: mit\nartifacts/resource_finder/models/moonlight-16b-a3b-instruct/README.md:3:library_name: transformers\nartifacts/resource_finder/models/moonlight-16b-a3b-instruct/README.md:95:We introduce how to use our model at inference stage using transformers library. It is recommended to use python=3.10, torch>=2.1.0, and transformers=4.48.2 as the development environment. \nartifacts/resource_finder/models/moonlight-16b-a3b-instruct/README.md:99:from transformers import AutoModelForCausalLM, AutoTokenizer\nartifacts/resource_finder/models/moonlight-16b-a3b-instruct/README.md:120:from transformers import AutoModelForCausalLM, AutoTokenizer\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:2:license: apache-2.0\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:3:license_link: https://huggingface.co/Qwen/Qwen2.5-7B-Instruct/blob/main/LICENSE\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:10:library_name: transformers\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:23:- Significant improvements in **instruction following**, **generating long texts** (over 8K tokens), **understanding structured data** (e.g, tables), and **generating structured outputs** especially JSON. **More resilient to the diversity of system prompts**, enhancing role-play implementation and condition-setting for chatbots.\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:30:- Architecture: transformers with RoPE, SwiGLU, RMSNorm, and Attention QKV bias\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:42:The code of Qwen2.5 has been in the latest Hugging face `transformers` and we advise you to use the latest version of `transformers`.\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:44:With `transformers<4.37.0`, you will encounter the following error:\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:54:from transformers import AutoModelForCausalLM, AutoTokenizer\nartifacts/resource_finder/models/qwen2.5-7b-judge/README.md:106:Please refer to our [Documentation](https://qwen.readthedocs.io/en/latest/deployment/vllm.html) for usage if you are not familar with vLLM.\nartifacts/resource_finder/models/qwen3-8b/README.md:2:library_name: transformers\nartifacts/resource_finder/models/qwen3-8b/README.md:3:license: apache-2.0\nartifacts/resource_finder/models/qwen3-8b/README.md:4:license_link: https://huggingface.co/Qwen/Qwen3-8B/blob/main/LICENSE\nartifacts/resource_finder/models/qwen3-8b/README.md:19:- **Uniquely support of seamless switching between thinking mode** (for complex logical reasoning, math, and coding) and **non-thinking mode** (for efficient, general-purpose dialogue) **within single model**, ensuring optimal performance across various scenarios.\nartifacts/resource_finder/models/qwen3-8b/README.md:20:- **Significantly enhancement in its reasoning capabilities**, surpassing previous QwQ (in thinking mode) and Qwen2.5 instruct models (in non-thinking mode) on mathematics, code generation, and commonsense logical reasoning.\nartifacts/resource_finder/models/qwen3-8b/README.md:22:- **Expertise in agent capabilities**, enabling precise integration with external tools in both thinking and unthinking modes and achieving leading performance among open-source models in complex agent-based tasks.\nartifacts/resource_finder/models/qwen3-8b/README.md:40:The code of Qwen3 has been in the latest Hugging Face `transformers` and we advise you to use the latest version of `transformers`.\nartifacts/resource_finder/models/qwen3-8b/README.md:42:With `transformers<4.51.0`, you will encounter the following error:\nartifacts/resource_finder/models/qwen3-8b/README.md:49:from transformers import AutoModelForCausalLM, AutoTokenizer\nartifacts/resource_finder/models/qwen3-8b/README.md:70:    enable_thinking=True # Switches between thinking and non-thinking modes. Default is True.\nartifacts/resource_finder/models/qwen3-8b/README.md:81:# parsing thinking content\nartifacts/resource_finder/models/qwen3-8b/README.md:83:    # rindex finding 151668 (</think>)\nartifacts/resource_finder/models/qwen3-8b/README.md:88:thinking_content = tokenizer.decode(output_ids[:index], skip_special_tokens=True).strip(\"\\n\")\nartifacts/resource_finder/models/qwen3-8b/README.md:91:print(\"thinking content:\", thinking_content)\nartifacts/resource_finder/models/qwen3-8b/README.md:95:For deployment, you can use `sglang>=0.4.6.post1` or `vllm>=0.8.5` or to create an OpenAI-compatible API endpoint:\nartifacts/resource_finder/models/qwen3-8b/README.md:102:    vllm serve Qwen/Qwen3-8B --enable-reasoning --reasoning-parser deepseek_r1\nartifacts/resource_finder/models/qwen3-8b/README.md:110:> The `enable_thinking` switch is also available in APIs created by SGLang and vLLM. \nartifacts/resource_finder/models/qwen3-8b/README.md:111:> Please refer to our documentation for [SGLang](https://qwen.readthedocs.io/en/latest/deployment/sglang.html#thinking-non-thinking-modes) and [vLLM](https://qwen.readthedocs.io/en/latest/deployment/vllm.html#thinking-non-thinking-modes) users.\nartifacts/resource_finder/models/qwen3-8b/README.md:113:### `enable_thinking=True`\nartifacts/resource_finder/models/qwen3-8b/README.md:115:By default, Qwen3 has thinking capabilities enabled, similar to QwQ-32B. This means the model will use its reasoning abilities to enhance the quality of generated responses. For example, when explicitly setting `enable_thinking=True` or leaving it as the default value in `tokenizer.apply_chat_template`, the model will engage its thinking mode.\nartifacts/resource_finder/models/qwen3-8b/README.md:122:    enable_thinking=True  # True is the default value for enable_thinking\nartifacts/resource_finder/models/qwen3-8b/README.md:126:In this mode, the model will generate think content wrapped in a `<think>...</think>` block, followed by the final response.\nartifacts/resource_finder/models/qwen3-8b/README.md:129:> For thinking mode, use `Temperature=0.6`, `TopP=0.95`, `TopK=20`, and `MinP=0` (the default setting in `generation_config.json`). **DO NOT use greedy decoding**, as it can lead to performance degradation and endless repetitions. For more detailed guidance, please refer to the [Best Practices](#best-practices) section.\nartifacts/resource_finder/models/qwen3-8b/README.md:132:### `enable_thinking=False`\nartifacts/resource_finder/models/qwen3-8b/README.md:134:We provide a hard switch to strictly disable the model's thinking behavior, aligning its functionality with the previous Qwen2.5-Instruct models. This mode is particularly useful in scenarios where disabling thinking is essential for enhancing efficiency.\nartifacts/resource_finder/models/qwen3-8b/README.md:141:    enable_thinking=False  # Setting enable_thinking=False disables thinking mode\nartifacts/resource_finder/models/qwen3-8b/README.md:145:In this mode, the model will not generate any think content and will not include a `<think>...</think>` block.\nartifacts/resource_finder/models/qwen3-8b/README.md:148:> For non-thinking mode, we suggest using `Temperature=0.7`, `TopP=0.8`, `TopK=20`, and `MinP=0`. For more detailed guidance, please refer to the [Best Practices](#best-practices) section.\nartifacts/resource_finder/models/qwen3-8b/README.md:152:We provide a soft switch mechanism that allows users to dynamically control the model's behavior when `enable_thinking=True`. Specifically, you can add `/think` and `/no_think` to user prompts or system messages to switch the model's thinking mode from turn to turn. The model will follow the most recent instruction in multi-turn conversations.\nartifacts/resource_finder/models/qwen3-8b/README.md:157:from transformers import AutoModelForCausalLM, AutoTokenizer\nartifacts/resource_finder/models/qwen3-8b/README.md:188:    # First input (without /think or /no_think tags, thinking mode is enabled by default)\nartifacts/resource_finder/models/qwen3-8b/README.md:195:    # Second input with /no_think\nartifacts/resource_finder/models/qwen3-8b/README.md:196:    user_input_2 = \"Then, how many r's in blueberries? /no_think\"\nartifacts/resource_finder/models/qwen3-8b/README.md:202:    # Third input with /think\nartifacts/resource_finder/models/qwen3-8b/README.md:203:    user_input_3 = \"Really? /think\"\nartifacts/resource_finder/models/qwen3-8b/README.md:210:> For API compatibility, when `enable_thinking=True`, regardless of whether the user uses `/think` or `/no_think`, the model will always output a block wrapped in `<think>...</think>`. However, the content inside this block may be empty if thinking is disabled.\nartifacts/resource_finder/models/qwen3-8b/README.md:211:> When `enable_thinking=False`, the soft switches are not valid. Regardless of any `/think` or `/no_think` tags input by the user, the model will not generate think content and will not include a `<think>...</think>` block.\nartifacts/resource_finder/models/qwen3-8b/README.md:235:    #         # Add: When the response content is `<think>this is the thought</think>this is the answer;\nartifacts/resource_finder/models/qwen3-8b/README.md:271:YaRN is currently supported by several inference frameworks, e.g., `transformers` and `llama.cpp` for local use, `vllm` and `sglang` for deployment. In general, there are two approaches to enabling YaRN for supported frameworks:\nartifacts/resource_finder/models/qwen3-8b/README.md:289:  For `vllm`, you can use\nartifacts/resource_finder/models/qwen3-8b/README.md:291:    vllm serve ... --rope-scaling '{\"rope_type\":\"yarn\",\"factor\":4.0,\"original_max_position_embeddings\":32768}' --max-model-len 131072  \nartifacts/resource_finder/models/qwen3-8b/README.md:309:> please upgrade `transformers>=4.51.0`.\nartifacts/resource_finder/models/qwen3-8b/README.md:327:   - For thinking mode (`enable_thinking=True`), use `Temperature=0.6`, `TopP=0.95`, `TopK=20`, and `MinP=0`. **DO NOT use greedy decoding**, as it can lead to performance degradation and endless repetitions.\nartifacts/resource_finder/models/qwen3-8b/README.md:328:   - For non-thinking mode (`enable_thinking=False`), we suggest using `Temperature=0.7`, `TopP=0.8`, `TopK=20`, and `MinP=0`.\nartifacts/resource_finder/models/qwen3-8b/README.md:337:4. **No Thinking Content in History**: In multi-turn conversations, the historical model output should only include the final output part and does not need to include the thinking content. It is implemented in the provided chat template in Jinja2. However, for frameworks that do not directly use the Jinja2 chat template, it is up to the developers to ensure that the best practice is followed.\nmoonlight-16b-a3b-instruct template: {%- for message in messages -%}{%- if loop.first and messages[0]['role'] != 'system' -%}<|im_system|>system<|im_middle|>You are a helpful assistant<|im_end|>{%- endif -%}{%- i